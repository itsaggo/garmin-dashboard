# Garmin Dashboard settings. No secrets go in this file:
# passwords and keys are entered with   docker exec -it garmin-dashboard python -m app.setup
# After changing anything here, run install.sh again to apply it.

# Port the dashboard is served on (http://<server-ip>:PORT)
PORT=8099
# Which server address to listen on. 0.0.0.0 = all of the server's network interfaces.
# To restrict it to one interface, put that interface's IP here (e.g. 192.168.1.50).
BIND_ADDRESS=0.0.0.0

# Time zone and units are set in the dashboard (Settings). This is only the starting time zone.
TZ=America/Chicago

# How often to pull new data (hours)
SYNC_INTERVAL_HOURS=4
# How far back the first sync goes, in days (official Personal API)
BACKFILL_DAYS=365
# How far back the first Garmin Connect sync goes (VO2 max, training status, readiness).
# This uses one request per day for training status, so keep it modest.
CONNECT_BACKFILL_DAYS=90
# Each later sync re-pulls this many recent days (sleep and HRV finalize late)
REFRESH_DAYS=7

# Names (not IPs) you open the dashboard by, comma-separated. Opening it by IP
# address always works. Examples: tower,tower.local   or your reverse-proxy domain.
# Anything not listed is refused (this blocks "DNS rebinding" attacks).
ALLOWED_HOSTS=

# Only if you put the dashboard behind an HTTPS reverse proxy:
# the exact public address (scheme, name, and port if not 443), e.g. https://garmin.example.com
ALLOWED_ORIGINS=
# Cookies are marked secure automatically when you sign in over HTTPS. true forces it always.
COOKIE_SECURE=false
# Only behind a reverse proxy or Cloudflare Tunnel: the address or range the proxy connects
# from (e.g. 172.17.0.0/16 for Docker's default network, or the proxy container's own IP).
# Requests from there are believed about who the real visitor is, so login limits count
# visitors instead of the proxy, and a new account can't be created from outside your network.
TRUSTED_PROXIES=
